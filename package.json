{
  "name": "transcoded",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "sync": "svelte-kit sync",
    "build": "svelte-kit sync && vite build",
    "production": "node --env-file=.env build",
    "preview": "vite preview",
    "test": "vitest",
    "check": "svelte-kit sync && npm run check:nosync",
    "check:nosync": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && FORCE_COLOR=1 watch -c -n 2 npm run check:nosync",
    "lint": "svelte-kit sync && eslint .",
    "lint:fix": "svelte-kit sync && eslint --fix ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tanstack/eslint-plugin-query": "^5.104.0",
    "@types/async-lock": "^1.4.2",
    "@types/node": "^24.19.2",
    "@types/spinnies": "^0.5.3",
    "eslint": "^10.11.0",
    "eslint-plugin-n": "^18.4.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "svelte": "^5.55.1",
    "svelte-check": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.0.3",
    "async-lock": "^1.4.1",
    "chalk": "^5.6.2",
    "execa": "^9.6.0",
    "nanoid": "^5.1.6",
    "spinnies": "^0.5.1",
    "yaml": "^2.8.1",
    "zod": "^4.3.6"
  },
  "//overrides": [
    "@sveltejs/kit:",
    "  * Force cookie to be ^0.7.0 to mitigate error as per: https://github.com/jshttp/cookie/pull/167",
    "",
    "Also I hate HATE *HATE* this method of commenting"
  ],
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.0"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
